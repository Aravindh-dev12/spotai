NODE_ENV=development
DATABASE_URL=mysql://form:form@localhost:3306/form
REDIS_URL=redis://localhost:6379
API_PORT=3000
API_BODY_LIMIT_BYTES=1000000
TRUST_PROXY=false
APP_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW_MS=60000

# Development may use stub. Production must use openai-compatible with key + model.
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=12000

# Development can use STUN only. Production validation requires TURN URLs + a coturn REST shared secret.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_SHARED_SECRET=
RTC_ICE_TTL_SECONDS=3600

MEDIA_BUCKET=form-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=form
S3_SECRET_ACCESS_KEY=form-local-secret
S3_FORCE_PATH_STYLE=true
